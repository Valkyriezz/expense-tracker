{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": false,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": ["./server/node_modules/@types", "./node_modules/@types"]
  },
  "include": ["api/**/*"],
  "exclude": ["server", "web", "node_modules"]
}
